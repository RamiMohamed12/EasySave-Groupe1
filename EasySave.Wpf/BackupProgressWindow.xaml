<Window x:Class="EasySave.Wpf.BackupProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progression de la Sauvegarde"
        Height="550"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Exécution en cours..." 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
        </StackPanel>

        <!-- Status Box -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushToken}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20"
                MinHeight="140">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status Title -->
                <TextBlock Grid.Row="0"
                           Name="StatusTitleTextBlock"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="0,0,0,12"
                           Text="⏳  SAUVEGARDE EN COURS" />

                <!-- Blank Line -->
                <TextBlock Grid.Row="1" Text="" Height="8" />

                <!-- Reason -->
                <TextBlock Grid.Row="2"
                           Name="ReasonTextBlock"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,12"
                           MinHeight="20" />

                <!-- Action -->
                <TextBlock Grid.Row="3"
                           Name="ActionTextBlock"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontStyle="Italic"
                           MinHeight="40"
                           Text="Si un logiciel métier est lancé, la sauvegarde se mettra automatiquement en pause." />
            </Grid>
        </Border>

        <!-- Details Box -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushToken}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20"
                MinHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Détails:" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Stretch" />
                    
                    <TextBlock Name="CurrentJobTextBlock"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               MinHeight="20"
                               HorizontalAlignment="Stretch"
                               Text="Sauvegarde en cours..." />
                    
                    <TextBlock Name="ProgressTextBlock"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               MinHeight="20"
                               Text="Progression: 0% (0/0 fichiers)" />
                    
                    <TextBlock Name="TransferredTextBlock"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               MinHeight="20"
                               Text="Transféré: 0 B / 0 B" />
                    
                    <ProgressBar Name="ProgressBar"
                                 Height="8"
                                 Margin="0,12,0,0"
                                 Background="{DynamicResource SidebarBrush}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Value="0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right">
            <Button Name="CloseButton"
                    Content="Fermer"
                    Click="CloseButton_Click"
                    Padding="12,8"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Background="{DynamicResource AccentSoftBrush}"
                    Foreground="{DynamicResource AccentBrush}"
                    Cursor="Hand"
                    FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
