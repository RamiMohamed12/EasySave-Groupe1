<Window x:Class="EasySave.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasySave"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="980">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Name="HeadingTextBlock"
                   Margin="0,0,0,8"
                   FontSize="18"
                   FontWeight="Bold"
                   Text="EasySave" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Name="ConfiguredJobsGroupBox" Margin="0,0,8,8">
                <DataGrid Name="JobsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionChanged="JobsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn x:Name="RunColumn" Binding="{Binding IsSelected}" Width="60" />
                        <DataGridTextColumn x:Name="NumberColumn" Binding="{Binding JobNumber}" IsReadOnly="True" Width="55" />
                        <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" IsReadOnly="True" Width="120" />
                        <DataGridTextColumn x:Name="TypeColumn" Binding="{Binding Type}" IsReadOnly="True" Width="110" />
                        <DataGridTextColumn x:Name="SourceColumn" Binding="{Binding Source}" Width="*" />
                        <DataGridTextColumn x:Name="TargetColumn" Binding="{Binding Target}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Name="EditSelectedJobGroupBox" Margin="8,0,0,8">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Name="SelectedJobLabel" Margin="0,0,0,10" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Name="SourceLabel" />
                    <TextBox Grid.Row="2" Name="SourceTextBox" Margin="0,4,0,8" />
                    <TextBlock Grid.Row="3" Name="TargetLabel" />
                    <TextBox Grid.Row="4" Name="TargetTextBox" Margin="0,4,0,10" />
                    <Button Grid.Row="5" Name="SaveSelectedJobButton" Height="30" Click="SaveSelectedJobButton_Click" />
                    <TextBlock Grid.Row="6"
                               Name="EditHintTextBlock"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="DimGray" />
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Name="StateGroupBox" Margin="0,0,8,8">
                <TextBox Name="StateTextBox"
                         Margin="8"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         TextWrapping="NoWrap" />
            </GroupBox>
            <GroupBox Grid.Column="1" Name="LogGroupBox" Margin="8,0,0,8">
                <TextBox Name="LogTextBox"
                         Margin="8"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         TextWrapping="NoWrap" />
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Name="LanguageLabel" Margin="0,7,6,0" />
            <ComboBox Name="LanguageComboBox"
                      Width="110"
                      Margin="0,0,12,0"
                      SelectionChanged="LanguageComboBox_SelectionChanged" />
            <Button Name="RefreshButton" Width="110" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button Name="RunSelectedButton" Width="130" Margin="0,0,8,0" Click="RunSelectedButton_Click" />
            <Button Name="RunAllButton" Width="110" Margin="0,0,8,0" Click="RunAllButton_Click" />
            <Button Name="SaveAllButton" Width="140" Click="SaveAllButton_Click" />
            <TextBlock Name="StatusTextBlock"
                       Margin="16,7,0,0"
                       FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
