<Window x:Class="EasySave.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasySave"
        Height="760"
        Width="1240"
        MinHeight="700"
        MinWidth="1080"
        Background="{DynamicResource CanvasBrush}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#101219" Offset="0" />
                <GradientStop Color="#20222A" Offset="0.52" />
                <GradientStop Color="#121318" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="980"
                 Height="520"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="240,-250,0,0"
                 Fill="#553B1EA4">
            <Ellipse.Effect>
                <BlurEffect Radius="95" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="680"
                 Height="420"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-190,0,0,-220"
                 Fill="#332F2B5D">
            <Ellipse.Effect>
                <BlurEffect Radius="80" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="520"
                 Height="420"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-180,-180"
                 Fill="#2E8B5CF6">
            <Ellipse.Effect>
                <BlurEffect Radius="88" />
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="6"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource BorderBrushToken}"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <TextBlock Text="ES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentHoverBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Name="SidebarTitleTextBlock"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="320"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        Background="{DynamicResource ControlBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1"
                        Padding="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Search"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Search backups..."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Theme"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="EasySave"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="276" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                CornerRadius="0"
                Padding="24"
                Margin="0,10,22,0"
                Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="BACKUP MENU"
                               Margin="0,0,0,24"
                               FontSize="12"
                               Foreground="#C6D1DD" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Name="OverviewNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OverviewNavButton_Click" />
                    <Button Name="TasksNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="TasksNavButton_Click" />
                    <Button Name="ExecutionNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ExecutionNavButton_Click" />
                    <Button Name="StateLogsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="StateLogsNavButton_Click" />
                </StackPanel>

                <Button Grid.Row="3"
                        Name="SettingsNavButton"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0"
                        Click="SettingsNavButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Name="HeadingTextBlock" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Name="PageSubtitleTextBlock"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Name="StatusTextBlock"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid Name="OverviewPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="210"
                            Margin="0,0,0,16"
                            CornerRadius="2"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#D8CAFF" Offset="0" />
                                <GradientStop Color="#C7B9FF" Offset="0.48" />
                                <GradientStop Color="#8061C8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="520"
                                     Height="260"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,10,-80,0"
                                     Fill="#7E4A129F">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="16" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="520"
                                     Height="240"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,80,-90"
                                     Stroke="#D8B4FE"
                                     StrokeThickness="5"
                                     Fill="#332C0A5D">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="3" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Path Stretch="Fill"
                                  Opacity="0.55"
                                  Fill="#3A21184A"
                                  Data="M 0,150 C 180,120 280,70 430,95 C 580,120 700,190 920,110 L 920,260 L 0,260 Z" />
                            <StackPanel Margin="42,34,0,0"
                                        Width="440"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                <TextBlock Text=".NET 10"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1A1523" />
                                <TextBlock Text="EasySave"
                                           Margin="0,10,0,0"
                                           FontSize="44"
                                           FontWeight="Bold"
                                           Foreground="#0D0B12" />
                                <TextBlock Text="A modern Fluent backup workspace for running jobs, tracking state, and reviewing logs."
                                           Margin="0,18,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#1E1A27" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12">
                        <Border Margin="0,0,8,0" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel>
                                <TextBlock Name="KpiTotalJobsLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Name="KpiTotalJobsValueTextBlock" FontSize="28" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel>
                                <TextBlock Name="KpiConfiguredJobsLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Name="KpiConfiguredJobsValueTextBlock" FontSize="28" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Style="{StaticResource PanelBorderStyle}">
                            <StackPanel>
                                <TextBlock Name="KpiSelectedJobsLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Name="KpiSelectedJobsValueTextBlock" FontSize="28" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelBorderStyle}">
                            <StackPanel>
                                <TextBlock Name="KpiStorageLabelTextBlock" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Name="KpiStorageValueTextBlock"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <GroupBox Grid.Row="2" Name="OverviewJobsGroupBox">
                        <DataGrid Name="OverviewJobsDataGrid"
                                  Margin="4"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No." Binding="{Binding JobNumber}" Width="60" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding ConfigurationStatus}" Width="120" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <Grid Name="TasksPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="AddJobButton"
                                    Width="130"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AddJobButton_Click" />
                            <Button Name="DeleteJobButton"
                                    Width="150"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="DeleteJobButton_Click" />
                            <Button Name="SaveAllButton"
                                    Width="150"
                                    Click="SaveAllButton_Click" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Name="ConfiguredJobsGroupBox" Margin="0,0,8,0">
                            <DataGrid Name="JobsDataGrid"
                                      Margin="4"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionChanged="JobsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn x:Name="RunColumn" Binding="{Binding IsSelected}" Width="55" />
                                    <DataGridTextColumn x:Name="NumberColumn" Binding="{Binding JobNumber}" IsReadOnly="True" Width="60" />
                                    <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" IsReadOnly="True" Width="120" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding ConfigurationStatus}" IsReadOnly="True" Width="110" />
                                    <DataGridTextColumn x:Name="TypeColumn" Binding="{Binding Type}" IsReadOnly="True" Width="130" />
                                    <DataGridTextColumn x:Name="SourceColumn" Binding="{Binding Source}" Width="*" />
                                    <DataGridTextColumn x:Name="TargetColumn" Binding="{Binding Target}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Name="EditSelectedJobGroupBox" Margin="8,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Name="SelectedJobLabel" Margin="0,0,0,12" FontWeight="Bold" />
                                    <TextBlock Grid.Row="1" Name="SourceLabel" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="2" Name="SourceTextBox" Margin="0,4,0,10" />
                                    <TextBlock Grid.Row="3" Name="TargetLabel" FontWeight="SemiBold" />
                                    <TextBox Grid.Row="4" Name="TargetTextBox" Margin="0,4,0,10" />
                                    <TextBlock Grid.Row="5" Name="TypeLabel" FontWeight="SemiBold" />
                                    <ComboBox Grid.Row="6" Name="TypeComboBox" Margin="0,4,0,12" />
                                    <Button Grid.Row="7"
                                            Name="SaveSelectedJobButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveSelectedJobButton_Click" />
                                    <TextBlock Grid.Row="8"
                                               Name="EditHintTextBlock"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>

                <Grid Name="ExecutionPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="RunSelectedButton"
                                    Width="180"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="RunSelectedButton_Click" />
                            <Button Name="RunAllButton"
                                    Width="150"
                                    Click="RunAllButton_Click" />
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Name="ExecutionJobsGroupBox">
                        <DataGrid Name="ExecutionJobsDataGrid"
                                  Margin="4"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Run" Binding="{Binding IsSelected}" Width="55" />
                                <DataGridTextColumn Header="No." Binding="{Binding JobNumber}" Width="60" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding ConfigurationStatus}" Width="120" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <Grid Name="StateLogsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Name="RefreshButton"
                            Width="130"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            Click="RefreshButton_Click" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Name="StateGroupBox" Margin="0,0,8,0">
                            <TextBox Name="StateTextBox"
                                     Margin="4"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{DynamicResource LogBackgroundBrush}"
                                     Foreground="{DynamicResource LogForegroundBrush}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Name="LogGroupBox" Margin="8,0,0,0">
                            <TextBox Name="LogTextBox"
                                     Margin="4"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{DynamicResource LogBackgroundBrush}"
                                     Foreground="{DynamicResource LogForegroundBrush}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </GroupBox>
                    </Grid>
                </Grid>

                <Grid Name="SettingsPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Name="SettingsTitleTextBlock" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="AppearanceSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="ThemeLabel" Width="120" Margin="0,7,8,0" />
                                        <ComboBox Name="ThemeComboBox"
                                                  Width="160"
                                                  SelectionChanged="ThemeComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="LanguageSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="LanguageLabel" Width="120" Margin="0,7,8,0" />
                                        <ComboBox Name="LanguageComboBox"
                                                  Width="160"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="LogFormatSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="LogFormatLabel" Width="120" Margin="0,7,8,0" />
                                        <ComboBox Name="LogFormatComboBox"
                                                  Width="160"
                                                  SelectionChanged="LogFormatComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="EncryptionSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Name="EncryptedExtensionsLabel" Margin="0,0,0,4" />
                                    <TextBox Name="EncryptedExtensionsTextBox" Width="420" HorizontalAlignment="Left" />
                                    <TextBlock Name="CryptoSoftKeyLabel" Margin="0,10,0,4" />
                                    <TextBox Name="CryptoSoftKeyTextBox" Width="420" HorizontalAlignment="Left" />
                                    <Button Name="SaveEncryptionSettingsButton"
                                            Width="210"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveEncryptionSettingsButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock Name="BusinessSoftwareSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Name="BlockedProcessesLabel"
                                               Margin="0,0,0,6"
                                               FontWeight="SemiBold" />
                                    <ListBox Name="BlockedProcessesListBox"
                                             Width="420"
                                             MinHeight="120"
                                             MaxHeight="220"
                                             HorizontalAlignment="Left" />
                                    <TextBlock Name="ProcessNameLabel"
                                               Margin="0,10,0,4" />
                                    <TextBox Name="ProcessNameTextBox"
                                             Width="420"
                                             HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Name="AddProcessButton"
                                                Width="150"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="AddProcessButton_Click" />
                                        <Button Name="RemoveProcessButton"
                                                Width="190"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="RemoveProcessButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
    </Grid>
</Window>
