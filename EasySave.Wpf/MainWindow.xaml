<Window x:Class="EasySave.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasySave"
        Height="760"
        Width="1240"
        MinHeight="700"
        MinWidth="1080"
        Background="#F4F6FA">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                CornerRadius="12"
                Padding="14"
                Margin="0,0,10,0"
                Background="#1F2937">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Name="SidebarTitleTextBlock"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White" />

                <Button Grid.Row="1"
                        Name="OverviewNavButton"
                        Height="36"
                        Margin="0,20,0,8"
                        Click="OverviewNavButton_Click" />
                <Button Grid.Row="2"
                        Name="TasksNavButton"
                        Height="36"
                        Margin="0,0,0,8"
                        Click="TasksNavButton_Click" />
                <Button Grid.Row="3"
                        Name="ExecutionNavButton"
                        Height="36"
                        Margin="0,0,0,8"
                        Click="ExecutionNavButton_Click" />
                <Button Grid.Row="4"
                        Name="StateLogsNavButton"
                        Height="36"
                        Margin="0,0,0,8"
                        Click="StateLogsNavButton_Click" />
                <Button Grid.Row="6"
                        Name="SettingsNavButton"
                        Height="36"
                        Click="SettingsNavButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Name="HeadingTextBlock" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Name="PageSubtitleTextBlock" Margin="0,4,0,0" Foreground="#4B5563" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Name="StatusTextBlock"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#1D4ED8" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid Name="OverviewPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                        <Border Margin="0,0,8,0" Padding="14" CornerRadius="10" Background="White">
                            <StackPanel>
                                <TextBlock Name="KpiTotalJobsLabelTextBlock" Foreground="#6B7280" />
                                <TextBlock Name="KpiTotalJobsValueTextBlock" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="14" CornerRadius="10" Background="White">
                            <StackPanel>
                                <TextBlock Name="KpiConfiguredJobsLabelTextBlock" Foreground="#6B7280" />
                                <TextBlock Name="KpiConfiguredJobsValueTextBlock" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="14" CornerRadius="10" Background="White">
                            <StackPanel>
                                <TextBlock Name="KpiSelectedJobsLabelTextBlock" Foreground="#6B7280" />
                                <TextBlock Name="KpiSelectedJobsValueTextBlock" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Padding="14" CornerRadius="10" Background="White">
                            <StackPanel>
                                <TextBlock Name="KpiStorageLabelTextBlock" Foreground="#6B7280" />
                                <TextBlock Name="KpiStorageValueTextBlock" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <GroupBox Grid.Row="1" Name="OverviewJobsGroupBox" Background="White">
                        <DataGrid Name="OverviewJobsDataGrid"
                                  Margin="8"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding JobNumber}" Width="60" />
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" />
                                <DataGridTextColumn Header="Cible" Binding="{Binding Target}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <Grid Name="TasksPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Name="AddJobButton" Width="130" Height="34" Margin="0,0,8,0" Click="AddJobButton_Click" />
                        <Button Name="DeleteJobButton" Width="150" Height="34" Margin="0,0,8,0" Click="DeleteJobButton_Click" />
                        <Button Name="SaveAllButton" Width="150" Height="34" Click="SaveAllButton_Click" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Name="ConfiguredJobsGroupBox" Margin="0,0,8,0" Background="White">
                            <DataGrid Name="JobsDataGrid"
                                      Margin="8"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionChanged="JobsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn x:Name="RunColumn" Binding="{Binding IsSelected}" Width="55" />
                                    <DataGridTextColumn x:Name="NumberColumn" Binding="{Binding JobNumber}" IsReadOnly="True" Width="60" />
                                    <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" IsReadOnly="True" Width="130" />
                                    <DataGridTextColumn x:Name="TypeColumn" Binding="{Binding Type}" IsReadOnly="True" Width="130" />
                                    <DataGridTextColumn x:Name="SourceColumn" Binding="{Binding Source}" Width="*" />
                                    <DataGridTextColumn x:Name="TargetColumn" Binding="{Binding Target}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Name="EditSelectedJobGroupBox" Margin="8,0,0,0" Background="White">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Name="SelectedJobLabel" Margin="0,0,0,10" FontWeight="Bold" />
                                    <TextBlock Grid.Row="1" Name="SourceLabel" />
                                    <TextBox Grid.Row="2" Name="SourceTextBox" Margin="0,4,0,8" />
                                    <TextBlock Grid.Row="3" Name="TargetLabel" />
                                    <TextBox Grid.Row="4" Name="TargetTextBox" Margin="0,4,0,10" />
                                    <TextBlock Grid.Row="5" Name="TypeLabel" />
                                    <ComboBox Grid.Row="6" Name="TypeComboBox" Margin="0,4,0,10" />
                                    <Button Grid.Row="7" Name="SaveSelectedJobButton" Height="32" Click="SaveSelectedJobButton_Click" />
                                    <TextBlock Grid.Row="8"
                                               Name="EditHintTextBlock"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="DimGray" />
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>

                <Grid Name="ExecutionPanel" Visibility="Collapsed">
                    <StackPanel>
                        <Border Padding="14" Margin="0,0,0,10" Background="White" CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <Button Name="RunSelectedButton" Width="180" Height="36" Margin="0,0,8,0" Click="RunSelectedButton_Click" />
                                <Button Name="RunAllButton" Width="150" Height="36" Click="RunAllButton_Click" />
                            </StackPanel>
                        </Border>
                        <GroupBox Name="ExecutionJobsGroupBox" Background="White">
                            <DataGrid Name="ExecutionJobsDataGrid"
                                      Margin="8"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Run" Binding="{Binding IsSelected}" Width="55" />
                                    <DataGridTextColumn Header="N°" Binding="{Binding JobNumber}" Width="60" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </Grid>

                <Grid Name="StateLogsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Name="RefreshButton"
                            Width="130"
                            Height="34"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Click="RefreshButton_Click" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Name="StateGroupBox" Margin="0,0,8,0" Background="White">
                            <TextBox Name="StateTextBox"
                                     Margin="8"
                                     FontFamily="Consolas"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Name="LogGroupBox" Margin="8,0,0,0" Background="White">
                            <TextBox Name="LogTextBox"
                                     Margin="8"
                                     FontFamily="Consolas"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </GroupBox>
                    </Grid>
                </Grid>

                <Grid Name="SettingsPanel" Visibility="Collapsed">
                    <Border Padding="16" Background="White" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Name="SettingsTitleTextBlock" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Name="LanguageLabel" Margin="0,7,8,0" />
                                <ComboBox Name="LanguageComboBox"
                                          Width="140"
                                          SelectionChanged="LanguageComboBox_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
