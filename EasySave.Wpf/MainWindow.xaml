<Window x:Class="EasySave.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasySave"
        Height="760"
        Width="1240"
        MinHeight="700"
        MinWidth="1080"
        Background="{DynamicResource CanvasBrush}">
    <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                CornerRadius="0"
                Padding="10"
                Margin="0,10,0,0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrushToken}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid />

                <StackPanel Grid.Row="1">
                    <Button Name="OverviewNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="OverviewNavButton_Click" />
                    <Button Name="TasksNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="TasksNavButton_Click" />
                    <Button Name="ExecutionNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="ExecutionNavButton_Click" />
                    <Button Name="StateLogsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Click="StateLogsNavButton_Click" />
                </StackPanel>

                <Button Grid.Row="3"
                        Name="SettingsNavButton"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0"
                        Click="SettingsNavButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="-1,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Name="HeadingTextBlock" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Name="PageSubtitleTextBlock"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Name="StatusTextBlock"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid Name="OverviewPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="282"
                            Margin="0,0,0,16"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource HeroGradientStartColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource HeroGradientMidColor}" Offset="0.55" />
                                <GradientStop Color="{DynamicResource HeroGradientEndColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Path Stretch="Fill"
                                  Opacity="0.88"
                                  Fill="{DynamicResource HeroShapePrimaryBrush}"
                                  Data="M 660,0 C 780,18 900,70 1008,150 C 1112,226 1190,260 1240,242 L 1240,0 Z" />
                            <Path Stretch="Fill"
                                  Opacity="0.62"
                                  Stroke="{DynamicResource HeroShapeHighlightBrush}"
                                  StrokeThickness="3"
                                  Fill="{DynamicResource HeroShapeSecondaryBrush}"
                                  Data="M 720,282 C 774,172 858,126 980,148 C 1095,170 1180,228 1240,210 L 1240,282 Z" />
                            <Path Stretch="Fill"
                                  Opacity="0.48"
                                  Fill="{DynamicResource HeroWaveBrush}"
                                  Data="M 0,238 C 210,218 350,235 514,248 C 708,262 840,225 1016,205 C 1120,193 1190,202 1240,220 L 1240,282 L 0,282 Z" />
                            <StackPanel Margin="38,42,0,0"
                                        Width="420"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top">
                                <TextBlock Text=".NET 10"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                                <TextBlock Text="EasySave"
                                           Margin="0,8,0,0"
                                           FontSize="38"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                                <TextBlock Name="HeroDescriptionTextBlock"
                                           Margin="0,14,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource HeroTextBrush}" />
                                <Border Margin="0,22,0,0"
                                        Padding="12,7"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource HeroMetricSurfaceBrush}"
                                        BorderBrush="{DynamicResource HeroMetricBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Name="HeroStatusTextBlock"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroMetricTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <UniformGrid Rows="2"
                                         Columns="2"
                                         Width="500"
                                         Height="214"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,12,38,0">
                                <Border Margin="0,0,10,10"
                                        CornerRadius="8"
                                        Background="{DynamicResource HeroMetricSurfaceBrush}"
                                        BorderBrush="{DynamicResource HeroMetricBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Name="KpiTotalJobsValueTextBlock"
                                                   Margin="0,6,0,0"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroMetricTextBrush}" />
                                        <TextBlock Name="KpiTotalJobsLabelTextBlock"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HeroMetricMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,10"
                                        CornerRadius="8"
                                        Background="{DynamicResource HeroMetricSurfaceBrush}"
                                        BorderBrush="{DynamicResource HeroMetricBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Name="KpiConfiguredJobsValueTextBlock"
                                                   Margin="0,6,0,0"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroMetricTextBrush}" />
                                        <TextBlock Name="KpiConfiguredJobsLabelTextBlock"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HeroMetricMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,10,0"
                                        CornerRadius="8"
                                        Background="{DynamicResource HeroMetricSurfaceBrush}"
                                        BorderBrush="{DynamicResource HeroMetricBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Name="KpiSelectedJobsValueTextBlock"
                                                   Margin="0,6,0,0"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroMetricTextBrush}" />
                                        <TextBlock Name="KpiSelectedJobsLabelTextBlock"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HeroMetricMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8"
                                        Background="{DynamicResource HeroMetricSurfaceBrush}"
                                        BorderBrush="{DynamicResource HeroMetricBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Name="KpiStorageLabelTextBlock"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HeroMetricMutedBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Name="KpiStorageValueTextBlock"
                                                   Margin="0,2,0,0"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HeroMetricTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <GroupBox Grid.Row="1" Name="OverviewJobsGroupBox">
                        <DataGrid Name="OverviewJobsDataGrid"
                                  Margin="4"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No." Binding="{Binding JobNumber}" Width="60" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding ConfigurationStatus}" Width="120" />
                                <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeStatus}" Width="130" />
                                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" Width="100" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <Grid Name="TasksPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="AddJobButton"
                                    Width="160"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AddJobButton_Click" />
                            <Button Name="EditJobButton"
                                    Width="170"
                                    Margin="0,0,8,0"
                                    Click="EditJobButton_Click" />
                            <Button Name="DeleteJobButton"
                                    Width="170"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="DeleteJobButton_Click" />
                            <Button Name="SaveAllButton"
                                    Width="170"
                                    Click="SaveAllButton_Click" />
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Name="ConfiguredJobsGroupBox">
                        <DataGrid Name="JobsDataGrid"
                                  Margin="4"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionChanged="JobsDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn x:Name="RunColumn" Binding="{Binding IsSelected}" Width="55" IsReadOnly="False" />
                                <DataGridTextColumn x:Name="NumberColumn" Binding="{Binding JobNumber}" IsReadOnly="True" Width="60" />
                                <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" IsReadOnly="True" Width="140" />
                                <DataGridTextColumn Header="Status" Binding="{Binding ConfigurationStatus}" IsReadOnly="True" Width="110" />
                                <DataGridTextColumn x:Name="TypeColumn" Binding="{Binding Type}" IsReadOnly="True" Width="130" />
                                <DataGridTextColumn x:Name="SourceColumn" Binding="{Binding Source}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn x:Name="TargetColumn" Binding="{Binding Target}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <Grid Name="ExecutionPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="RunSelectedButton"
                                    Width="210"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="RunSelectedButton_Click" />
                            <Button Name="RunAllButton"
                                    Width="170"
                                    Click="RunAllButton_Click" />
                            <Button Name="PauseSelectedButton"
                                    Width="170"
                                    Margin="8,0,0,0"
                                    Click="PauseSelectedButton_Click" />
                            <Button Name="ResumeSelectedButton"
                                    Width="180"
                                    Margin="8,0,0,0"
                                    Click="ResumeSelectedButton_Click" />
                            <Button Name="StopSelectedButton"
                                    Width="170"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="StopSelectedButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Name="BusinessSoftwareBanner"
                            Visibility="Collapsed"
                            Background="{DynamicResource WarningBrush}"
                            CornerRadius="4"
                            Padding="12,8"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ "
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                            <TextBlock Name="BusinessSoftwareBannerText"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="2" Name="ExecutionJobsGroupBox">
                        <DataGrid Name="ExecutionJobsDataGrid"
                                  Margin="4"
                                  IsReadOnly="False"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Run" Binding="{Binding IsSelected}" Width="55" IsReadOnly="False" />
                                <DataGridTextColumn Header="No." Binding="{Binding JobNumber}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Status" Binding="{Binding ConfigurationStatus}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeStatus}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Current file" Binding="{Binding CurrentFile}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Transfer mode" Binding="{Binding TransferMode}" Width="150" IsReadOnly="True" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" IsReadOnly="True" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <Grid Name="StateLogsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Name="RefreshButton"
                            Width="150"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Left"
                            Click="RefreshButton_Click" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Name="StateGroupBox" Margin="0,0,8,0">
                            <TextBox Name="StateTextBox"
                                     Margin="4"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{DynamicResource LogBackgroundBrush}"
                                     Foreground="{DynamicResource LogForegroundBrush}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Name="LogGroupBox" Margin="8,0,0,0">
                            <TextBox Name="LogTextBox"
                                     Margin="4"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="{DynamicResource LogBackgroundBrush}"
                                     Foreground="{DynamicResource LogForegroundBrush}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </GroupBox>
                    </Grid>
                </Grid>

                <Grid Name="SettingsPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Name="SettingsTitleTextBlock" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="AppearanceSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="ThemeLabel" Width="120" Margin="0,7,8,0" />
                                        <ComboBox Name="ThemeComboBox"
                                                  Width="160"
                                                  SelectionChanged="ThemeComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="LanguageSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="LanguageLabel" Width="120" Margin="0,7,8,0" />
                                        <ComboBox Name="LanguageComboBox"
                                                  Width="160"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="LogFormatSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Name="LogFormatLabel" Width="120" Margin="0,7,8,0" />
                                        <ComboBox Name="LogFormatComboBox"
                                                  Width="160"
                                                  SelectionChanged="LogFormatComboBox_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="RuntimeRulesSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Name="PriorityExtensionsLabel" Margin="0,0,0,4" />
                                    <TextBox Name="PriorityExtensionsTextBox" Width="420" HorizontalAlignment="Left" />
                                    <TextBlock Name="LargeFileThresholdLabel" Margin="0,10,0,4" />
                                    <TextBox Name="LargeFileThresholdTextBox" Width="160" HorizontalAlignment="Left" />
                                    <TextBlock Name="MaxConcurrencyLabel" Margin="0,10,0,4" />
                                    <TextBox Name="MaxConcurrencyTextBox" Width="160" HorizontalAlignment="Left" />
                                    <Button Name="SaveRuntimeRulesButton"
                                            Width="270"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveRuntimeRulesButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Name="EncryptionSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Name="EncryptedExtensionsLabel" Margin="0,0,0,4" />
                                    <TextBox Name="EncryptedExtensionsTextBox" Width="420" HorizontalAlignment="Left" />
                                    <TextBlock Name="CryptoSoftKeyLabel" Margin="0,10,0,4" />
                                    <TextBox Name="CryptoSoftKeyTextBox" Width="420" HorizontalAlignment="Left" />
                                    <Button Name="SaveEncryptionSettingsButton"
                                            Width="270"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveEncryptionSettingsButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock Name="BusinessSoftwareSectionTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock Name="BlockedProcessesLabel"
                                               Margin="0,0,0,6"
                                               FontWeight="SemiBold" />
                                    <ListBox Name="BlockedProcessesListBox"
                                             Width="420"
                                             MinHeight="120"
                                             MaxHeight="220"
                                             HorizontalAlignment="Left" />
                                    <TextBlock Name="ProcessNameLabel"
                                               Margin="0,10,0,4" />
                                    <TextBox Name="ProcessNameTextBox"
                                             Width="420"
                                             HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Name="AddProcessButton"
                                                Width="220"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="AddProcessButton_Click" />
                                        <Button Name="RemoveProcessButton"
                                                Width="240"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="RemoveProcessButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- Popup overlay edition de tache -->
                <Grid Name="EditJobOverlay" Visibility="Collapsed" Panel.ZIndex="100">
                    <Rectangle Fill="Black" Opacity="0.45" />
                    <Border MaxWidth="480"
                            MaxHeight="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="8"
                            Padding="24"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrushToken}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Titre + bouton fermer -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Name="SelectedJobLabel" FontWeight="Bold" FontSize="15"
                                           VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right"
                                        Width="28" Height="28"
                                        FontFamily="Segoe MDL2 Assets"
                                        Content="&#xE711;"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CloseEditPopup_Click" />
                            </Grid>

                            <TextBlock Grid.Row="1" Name="NameLabel" FontWeight="SemiBold" />
                            <TextBox Grid.Row="2" Name="NameTextBox" Margin="0,4,0,10" MinWidth="380" />
                            <TextBlock Grid.Row="3" Name="SourceLabel" FontWeight="SemiBold" />
                            <TextBox Grid.Row="4" Name="SourceTextBox" Margin="0,4,0,10" />
                            <TextBlock Grid.Row="5" Name="TargetLabel" FontWeight="SemiBold" />
                            <TextBox Grid.Row="6" Name="TargetTextBox" Margin="0,4,0,10" />
                            <TextBlock Grid.Row="7" Name="TypeLabel" FontWeight="SemiBold" />
                            <ComboBox Grid.Row="8" Name="TypeComboBox" Margin="0,4,0,16" />
                            <Grid Grid.Row="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Name="SaveSelectedJobButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveSelectedJobButton_Click" />
                                <Button Grid.Column="2"
                                        Width="110"
                                        Name="CancelEditButton"
                                        Click="CloseEditPopup_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
    </Grid>
    </Grid>
</Window>
