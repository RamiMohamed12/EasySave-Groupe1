<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sober modern light palette: near-white surfaces, slate text, indigo accent, semantic green / amber / red -->
    <Color x:Key="CanvasColor">#F6F7F9</Color>
    <Color x:Key="TitleBarColor">#F6F7F9</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#F3F4F6</Color>
    <Color x:Key="ControlColor">#F3F4F6</Color>
    <Color x:Key="ControlHoverColor">#E5E7EB</Color>
    <Color x:Key="ControlSelectedColor">#E0E7FF</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="BorderSoftColor">#EEF0F3</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#374151</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <Color x:Key="SidebarTextColor">#1F2937</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#0067C0</Color>
    <Color x:Key="AccentHoverColor">#005A9E</Color>
    <Color x:Key="AccentSoftColor">#EAF4FF</Color>
    <!-- Semantic indicators: green for success, orange for warning, red for failure -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSurfaceColor">#FEF3C7</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerSoftColor">#FEE2E2</Color>
    <Color x:Key="LogBackgroundColor">#0F172A</Color>
    <Color x:Key="LogForegroundColor">#E5E7EB</Color>
    <Color x:Key="HeroGradientStartColor">#EEF2FF</Color>
    <Color x:Key="HeroGradientMidColor">#D7ECFF</Color>
    <Color x:Key="HeroGradientEndColor">#E0E7FF</Color>
    <Color x:Key="HeroShapePrimaryColor">#0067C0</Color>
    <Color x:Key="HeroShapeSecondaryColor">#3AA0E6</Color>
    <Color x:Key="HeroShapeHighlightColor">#B9E2FF</Color>
    <Color x:Key="HeroWaveColor">#FFFFFF</Color>
    <Color x:Key="HeroTextColor">#111827</Color>
    <Color x:Key="HeroMetricTextColor">#111827</Color>
    <Color x:Key="HeroMetricMutedColor">#4B5563</Color>
    <Color x:Key="HeroMetricSurfaceColor">#CCFFFFFF</Color>
    <Color x:Key="HeroMetricBorderColor">#99FFFFFF</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{DynamicResource TitleBarColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{DynamicResource ControlColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ControlHoverColor}" />
    <SolidColorBrush x:Key="ControlSelectedBrush" Color="{DynamicResource ControlSelectedColor}" />
    <SolidColorBrush x:Key="BorderBrushToken" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{DynamicResource BorderSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{DynamicResource SidebarTextColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{DynamicResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource DangerSoftColor}" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{DynamicResource LogBackgroundColor}" />
    <SolidColorBrush x:Key="LogForegroundBrush" Color="{DynamicResource LogForegroundColor}" />
    <SolidColorBrush x:Key="HeroTextBrush" Color="{DynamicResource HeroTextColor}" />
    <SolidColorBrush x:Key="HeroMetricTextBrush" Color="{DynamicResource HeroMetricTextColor}" />
    <SolidColorBrush x:Key="HeroMetricMutedBrush" Color="{DynamicResource HeroMetricMutedColor}" />
    <SolidColorBrush x:Key="HeroMetricSurfaceBrush" Color="{DynamicResource HeroMetricSurfaceColor}" />
    <SolidColorBrush x:Key="HeroMetricBorderBrush" Color="{DynamicResource HeroMetricBorderColor}" />
    <SolidColorBrush x:Key="HeroShapePrimaryBrush" Color="{DynamicResource HeroShapePrimaryColor}" />
    <SolidColorBrush x:Key="HeroShapeSecondaryBrush" Color="{DynamicResource HeroShapeSecondaryColor}" />
    <SolidColorBrush x:Key="HeroShapeHighlightBrush" Color="{DynamicResource HeroShapeHighlightColor}" />
    <SolidColorBrush x:Key="HeroWaveBrush" Color="{DynamicResource HeroWaveColor}" />
</ResourceDictionary>
