<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#111318</Color>
    <Color x:Key="SidebarColor">#E6181D27</Color>
    <Color x:Key="SurfaceColor">#B3292B33</Color>
    <Color x:Key="SurfaceRaisedColor">#CC30333D</Color>
    <Color x:Key="ControlColor">#CC242833</Color>
    <Color x:Key="BorderColor">#66838898</Color>
    <Color x:Key="BorderSoftColor">#334C5260</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#CBD5E1</Color>
    <Color x:Key="TextMutedColor">#AEB4C0</Color>
    <Color x:Key="AccentColor">#BCA7FF</Color>
    <Color x:Key="AccentHoverColor">#D7CCFF</Color>
    <Color x:Key="AccentSoftColor">#553B2A69</Color>
    <Color x:Key="SuccessColor">#C4B5FD</Color>
    <Color x:Key="WarningColor">#F8C96A</Color>
    <Color x:Key="WarningSurfaceColor">#6645331D</Color>
    <Color x:Key="DangerColor">#FF8A9A</Color>
    <Color x:Key="DangerSoftColor">#663A1822</Color>
    <Color x:Key="LogBackgroundColor">#CC191B22</Color>
    <Color x:Key="LogForegroundColor">#E5E7EB</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{DynamicResource ControlColor}" />
    <SolidColorBrush x:Key="BorderBrushToken" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{DynamicResource BorderSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{DynamicResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource DangerSoftColor}" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="{DynamicResource LogBackgroundColor}" />
    <SolidColorBrush x:Key="LogForegroundBrush" Color="{DynamicResource LogForegroundColor}" />
</ResourceDictionary>
