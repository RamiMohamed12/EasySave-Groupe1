<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CryptoSoft\CryptoSoft.csproj" ReferenceOutputAssembly="false" Private="false" BuildReference="false" />
    <ProjectReference Include="..\EasySave.Core\EasySave.Core.csproj" />
    <ProjectReference Include="..\EasyLog\EasyLog.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <CodeSigningCertificate>$(EasySaveCodeSigningCertificate)</CodeSigningCertificate>
    <CodeSigningCertificatePassword>$(EasySaveCodeSigningCertificatePassword)</CodeSigningCertificatePassword>
    <SignToolPath Condition="'$(EasySaveSignToolPath)' != ''">$(EasySaveSignToolPath)</SignToolPath>
    <SignToolPath Condition="'$(SignToolPath)' == ''">C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe</SignToolPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\EasySaveLogo.png" />
  </ItemGroup>

  <Target Name="CopyCryptoSoftOutput" AfterTargets="Build" Condition="'$(SkipCryptoSoftCopy)' != 'true'">
    <ItemGroup>
      <CryptoSoftRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\CryptoSoft.*" />
      <CryptoSoftRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\win-x64\CryptoSoft.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CryptoSoftRuntimeFiles)"
          DestinationFolder="$(OutDir)CryptoSoft\"
          SkipUnchangedFiles="true"
          Condition="'@(CryptoSoftRuntimeFiles)' != ''" />
  </Target>

  <Target Name="CopyCryptoSoftPublishOutput" AfterTargets="Publish" Condition="'$(SkipCryptoSoftCopy)' != 'true'">
    <ItemGroup>
      <CryptoSoftPublishRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\CryptoSoft.*" />
      <CryptoSoftPublishRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\win-x64\CryptoSoft.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CryptoSoftPublishRuntimeFiles)"
          DestinationFolder="$(PublishDir)CryptoSoft\"
          SkipUnchangedFiles="true"
          Condition="'@(CryptoSoftPublishRuntimeFiles)' != ''" />
  </Target>

  <Target Name="SignEasySaveWpfExecutable"
          AfterTargets="Build"
          Condition="'$(SkipCodeSigning)' != 'true'
                     and Exists('$(SignToolPath)')
                     and Exists('$(CodeSigningCertificate)')
                     and '$(CodeSigningCertificatePassword)' != ''
                     and Exists('$(TargetDir)$(AssemblyName).exe')">
    <Exec Command="&quot;$(SignToolPath)&quot; sign /fd SHA256 /f &quot;$(CodeSigningCertificate)&quot; /p &quot;$(CodeSigningCertificatePassword)&quot; &quot;$(TargetDir)$(AssemblyName).exe&quot;" />
  </Target>

</Project>
