<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EasySave.Core\EasySave.Core.csproj" />
    <ProjectReference Include="..\CryptoSoft\CryptoSoft.csproj" ReferenceOutputAssembly="false" Private="false" BuildReference="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>


    <AssemblyName>EasySave</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="CopyCryptoSoftOutput" AfterTargets="Build" Condition="'$(SkipCryptoSoftCopy)' != 'true'">
    <ItemGroup>
      <CryptoSoftRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\CryptoSoft.*" />
      <CryptoSoftRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\win-x64\CryptoSoft.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CryptoSoftRuntimeFiles)"
          DestinationFolder="$(OutDir)CryptoSoft\"
          SkipUnchangedFiles="true"
          Condition="'@(CryptoSoftRuntimeFiles)' != ''" />
  </Target>

  <Target Name="CopyCryptoSoftPublishOutput" AfterTargets="Publish" Condition="'$(SkipCryptoSoftCopy)' != 'true'">
    <ItemGroup>
      <CryptoSoftPublishRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\CryptoSoft.*" />
      <CryptoSoftPublishRuntimeFiles Include="..\CryptoSoft\bin\$(Configuration)\net10.0\win-x64\CryptoSoft.*" />
    </ItemGroup>
    <Copy SourceFiles="@(CryptoSoftPublishRuntimeFiles)"
          DestinationFolder="$(PublishDir)CryptoSoft\"
          SkipUnchangedFiles="true"
          Condition="'@(CryptoSoftPublishRuntimeFiles)' != ''" />
  </Target>

</Project>
